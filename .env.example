# Node 22+; never place these values in VITE_* variables.
PORT=4317
# An OpenAI-compatible /chat/completions service. Model is intentionally not guessed.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=60000
AGENT_MAX_STEPS=24
AGENT_MAX_TOOL_CALLS=60
AGENT_TIMEOUT_MS=180000

# Optional planner service; omitted fields inherit the executor configuration.
PLANNER_MODEL=
PLANNER_BASE_URL=
PLANNER_API_KEY=
TASK_RUN_CONCURRENCY=4
TASK_MODEL_CONCURRENCY=4
TASK_READ_CONCURRENCY=8

# Optional, read-only ERPNext connector.
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Optional, read-only Zammad connector. Token needs ticket.agent permissions.
ZAMMAD_BASE_URL=
ZAMMAD_API_TOKEN=

# Optional report judge; omitted fields inherit executor configuration.
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
