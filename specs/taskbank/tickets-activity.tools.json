    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "tickets_sum_values",
    "description": "整数求和，不做币种换算。输入值需来自已读取记录。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "tickets_count_values",
    "description": "按精确字符串分组计数；缺失字段使用 (missing)。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "tickets_rank_values",
    "description": "按整数值排序，并列按记录 ID 字符串升序。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "records",
        "direction",
        "limit"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "tickets_publish_report",
    "description": "保存本地分析结果并检查结构化事实。不是企业系统写入，不发送消息；不返回标准答案。",
    "effect": "artifact",
    "parameters": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "object",
          "properties": {
            "comments_total": {
              "type": "integer"
            },
            "open_comments": {
              "type": "integer"
            }
          },
          "required": [
            "comments_total",
            "open_comments"
          ],
          "additionalProperties": false
        },
        "selectedIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        }
      },
      "required": [
        "metrics",
        "selectedIds",
        "evidenceIds",
        "summary"
      ],
      "additionalProperties": false
    }
  }
]
