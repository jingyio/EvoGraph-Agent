  {
    "name": "tickets_list_issues",
    "description": "分页读取当前任务范围内的记录，不返回任务外数据。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "page",
        "pageSize"
      ],
      "additionalProperties": false
    }
  },
