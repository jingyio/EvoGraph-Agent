[
  {
    "name": "support_list_complaints",
    "description": "分页列出本任务投诉记录及 ID；返回 records 数组（id、概要字段）、page、mayHaveMore。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "page",
        "pageSize"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "support_get_complaint",
    "description": "分析投诉产品、问题分类、企业和渠道；返回 product、sub_product、issue、sub_issue、company、submitted_via。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "complaintId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "complaintId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "support_get_response",
    "description": "核对企业响应类别和是否及时；返回 company_response、company_public_response、timely。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "complaintId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "complaintId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "support_get_dates",
    "description": "计算投诉接收到转交企业的时差；返回 date_received、date_sent_to_company。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "complaintId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "complaintId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "support_get_narrative",
    "description": "阅读消费者公开叙述或检查叙述是否为空；返回 narrative 文本。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "complaintId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "complaintId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "support_get_task_scope",
    "description": "读取当前任务范围、参考时间及输出字段名称；不返回参考答案。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "support_sum_values",
    "description": "整数求和，不做币种换算。输入值需来自已读取记录。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "support_count_values",
    "description": "按精确字符串分组计数；缺失字段使用 (missing)。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "support_rank_values",
    "description": "按整数值排序，并列按记录 ID 字符串升序。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "records",
        "direction",
        "limit"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "support_publish_report",
    "description": "保存本地分析结果并检查结构化事实。不是企业系统写入，不发送消息；不返回标准答案。",
    "effect": "artifact",
    "parameters": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "object",
          "properties": {
            "counts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          },
          "required": [
            "counts"
          ],
          "additionalProperties": false
        },
        "selectedIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        }
      },
      "required": [
        "metrics",
        "selectedIds",
        "evidenceIds",
        "summary"
      ],
      "additionalProperties": false
    }
  }
]
