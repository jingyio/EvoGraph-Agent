[
  {
    "name": "finance_list_orders",
    "description": "分页列出本任务订单记录及 ID；返回 records 数组（id、概要字段）、page、mayHaveMore。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "page",
        "pageSize"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "finance_get_order",
    "description": "查看订单状态和配送时间；返回 status、purchased_at、delivered_at、estimated_at。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "orderId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "finance_get_order_items",
    "description": "核对商品金额、运费及商家；返回 items，每项含 price_cents、freight_cents、product_id、seller_id。金额为 BRL 分。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "orderId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "finance_get_order_payments",
    "description": "核对支付金额、支付方式、分期和多笔支付；返回 payments，每项含 amount_cents、method、installments、sequence。金额为 BRL 分。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "orderId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "finance_get_customer",
    "description": "按客户地区汇总或识别同一客户；返回 customer_state、customer_id、customer_unique_id。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "orderId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "finance_get_order_reviews",
    "description": "查看订单满意度及评价内容；返回 reviews，含 score、title、body。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "orderId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "finance_get_task_scope",
    "description": "读取当前任务范围、参考时间及输出字段名称；不返回参考答案。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "finance_sum_values",
    "description": "整数求和，不做币种换算。输入值需来自已读取记录。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "finance_count_values",
    "description": "按精确字符串分组计数；缺失字段使用 (missing)。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "finance_rank_values",
    "description": "按整数值排序，并列按记录 ID 字符串升序。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "records",
        "direction",
        "limit"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "finance_publish_report",
    "description": "保存本地分析结果并检查结构化事实。不是企业系统写入，不发送消息；不返回标准答案。",
    "effect": "artifact",
    "parameters": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "object",
          "properties": {
            "paid_cents": {
              "type": "integer"
            },
            "items_cents": {
              "type": "integer"
            },
            "freight_cents": {
              "type": "integer"
            }
          },
          "required": [
            "paid_cents",
            "items_cents",
            "freight_cents"
          ],
          "additionalProperties": false
        },
        "selectedIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        }
      },
      "required": [
        "metrics",
        "selectedIds",
        "evidenceIds",
        "summary"
      ],
      "additionalProperties": false
    }
  }
]
