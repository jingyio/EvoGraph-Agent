[
  {
    "name": "tickets_list_issues",
    "description": "分页列出本任务技术工单记录及 ID；返回 records 数组（id、概要字段）、page、mayHaveMore。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "page",
        "pageSize"
      ],
      "additionalProperties": false
    },
    "outputs": [
      "id",
      "state",
      "title"
    ]
  },
  {
    "name": "tickets_get_issue",
    "description": "盘点技术问题状态、创建时间和更新时间；返回 title、state、created_at、updated_at。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "issueId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "issueId"
      ],
      "additionalProperties": false
    },
    "outputs": [
      "id",
      "title",
      "state",
      "created_at",
      "updated_at"
    ]
  },
  {
    "name": "tickets_get_labels",
    "description": "按标签分类、筛选 bug 或检查缺少标签；返回 labels 字符串数组。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "issueId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "issueId"
      ],
      "additionalProperties": false
    },
    "outputs": [
      "id",
      "labels"
    ]
  },
  {
    "name": "tickets_get_assignment",
    "description": "检查技术工单是否有负责人；返回 assignee_count 指派人数。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "issueId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "issueId"
      ],
      "additionalProperties": false
    },
    "outputs": [
      "id",
      "assignee_count"
    ]
  },
  {
    "name": "tickets_get_milestone",
    "description": "检查技术工单是否设置里程碑；返回 milestone（编号、标题或 null）。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "issueId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "issueId"
      ],
      "additionalProperties": false
    },
    "outputs": [
      "id",
      "milestone"
    ]
  },
  {
    "name": "tickets_get_activity",
    "description": "统计讨论评论数、筛选无评论或近期活动；返回 comments、updated_at。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "issueId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "issueId"
      ],
      "additionalProperties": false
    },
    "outputs": [
      "id",
      "comments",
      "updated_at"
    ]
  },
  {
    "name": "tickets_get_resolution",
    "description": "计算技术问题从创建到关闭的周期；返回 state、created_at、closed_at。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "issueId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "issueId"
      ],
      "additionalProperties": false
    },
    "outputs": [
      "id",
      "state",
      "created_at",
      "closed_at"
    ]
  },
  {
    "name": "tickets_get_body",
    "description": "阅读技术问题描述与原始链接；返回 body、url。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "issueId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "issueId"
      ],
      "additionalProperties": false
    },
    "outputs": [
      "id",
      "body",
      "url"
    ]
  },
  {
    "name": "tickets_get_task_scope",
    "description": "读取当前任务范围、参考时间及输出字段名称；不返回参考答案。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "outputs": [
      "id",
      "asOf",
      "recordCount",
      "acceptance"
    ]
  },
  {
    "name": "tickets_sum_values",
    "description": "整数求和，不做币种换算。输入值需来自已读取记录。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    },
    "outputs": [
      "sum"
    ]
  },
  {
    "name": "tickets_count_values",
    "description": "按精确字符串分组计数；缺失字段使用 (missing)。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    },
    "outputs": [
      "counts"
    ]
  },
  {
    "name": "tickets_rank_values",
    "description": "按整数值排序，并列按记录 ID 字符串升序。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "records",
        "direction",
        "limit"
      ],
      "additionalProperties": false
    },
    "outputs": [
      "ids"
    ]
  },
  {
    "name": "tickets_publish_report",
    "description": "保存本地分析结果并检查结构化事实。不是企业系统写入，不发送消息；不返回标准答案。",
    "effect": "artifact",
    "parameters": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "object",
          "properties": {
            "unassigned_count": {
              "type": "integer"
            }
          },
          "required": [
            "unassigned_count"
          ],
          "additionalProperties": false
        },
        "selectedIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        }
      },
      "required": [
        "metrics",
        "selectedIds",
        "evidenceIds",
        "summary"
      ],
      "additionalProperties": false
    }
  }
]
