[
  {
    "name": "get_business_clock",
    "description": "读取固定业务快照时间。账龄和 SLA 必须以此时间计算。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "publish_report",
    "description": "将当前真实业务状态渲染为结构化运营简报；输入只包含简短说明，金额和状态由系统计算。",
    "effect": "artifact",
    "parameters": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_invoices",
    "description": "读取全部应收发票、客户、币种、到期日和当前未分配余额，金额单位为分。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "list_payments",
    "description": "读取全部回款记录，包括银行流水引用、发票引用与剩余可分配金额。相同 bankRef 的记录须核查。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "get_invoice",
    "description": "按发票 ID 核查应收、客户及余额。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "invoiceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "invoiceId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "preview_payment_match",
    "description": "确定性校验一笔回款的银行流水唯一性、客户、币种、发票引用和余额，返回可分配明细或拒绝原因。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {
        "paymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "paymentId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "allocate_payment",
    "description": "在沙箱原子地保存一笔回款的匹配关系，禁止重复流水、跨客户、跨币种和超额匹配；相同明细可幂等重试。",
    "effect": "sandbox-write",
    "parameters": {
      "type": "object",
      "properties": {
        "paymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "invoiceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "amountCents": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "invoiceId",
              "amountCents"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "paymentId",
        "allocations"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_overdue_invoices",
    "description": "按业务快照日返回已逾期且仍有应收余额的发票；到期日当天不算逾期。",
    "effect": "read",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "create_finance_case",
    "description": "登记有依据的财务核查事项，相同 kind 与 entityId 幂等。仅保存在沙箱。",
    "effect": "sandbox-write",
    "parameters": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "duplicate",
            "unmatched",
            "overdue"
          ]
        },
        "entityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "kind",
        "entityId",
        "summary",
        "evidenceIds"
      ],
      "additionalProperties": false
    }
  }
]
