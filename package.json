{
  "name": "rsi-agent-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": ".venv/bin/python -m backend serve --reload",
    "build": "tsc --noEmit && vite build",
    "start": ".venv/bin/python -m backend serve",
    "test": ".venv/bin/python -m pytest -q",
    "check": ".venv/bin/python -m compileall -q backend && tsc --noEmit",
    "demo": ".venv/bin/python -m backend demo",
    "platforms": ".venv/bin/python -m backend platforms",
    "verify:platforms": ".venv/bin/python -m backend.verify_platforms"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
